{
  "name": "dsh-degeneration-watchdog",
  "version": "0.4.2",
  "description": "Watchdog for DSH: detects degenerated (looping) AI streaming output, aborts the turn, runs /compact, then sends a continue message.",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.1.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    }
  },
  "files": [
    "lib/index.js",
    "lib/detector.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
