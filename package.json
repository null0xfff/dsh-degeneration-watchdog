{
  "name": "dsh-degeneration-watchdog",
  "version": "0.8.1",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node lib/detector.test.mjs && node selftest-shortline.mjs && node --test lib/index.test.mjs",
    "test:integration": "node --test test/goal.integration.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-goal": "0.2.0-rc.2",
    "@deepseek-ai/dsh-goal-round-driver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2"
  },
  "description": "Watchdog for DSH: detects looping output, preserves queued input, compacts context, and resumes native Goals or ordinary conversations.",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.1.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    }
  },
  "files": [
    "lib/index.js",
    "lib/detector.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "license": "MIT"
}
